{
  "default_parameters": {
    "service_name": "Test Service",
    "service_slug": "test_service"
  },
  "commands": [
    "git init",
    "task -v init",
    "task -v dev-server-start",
    "task -v dev-server-start-container",
    "task -v lint ROOT_NENV=../../node_modules",
    "task -v lint-fix ROOT_NENV=../../node_modules",
    "task -v test",
    "task -v test-container",
    "task -v clean"
  ],
  "replays": [
    {
      "name": "Default",
      "parameters": {}
    },
    {
      "name": "With Trivy",
      "parameters": {
        "with_trivy": "true"
      }
    },
    {
      "name": "With Ngrok",
      "parameters": {
        "with_ngrok": "true"
      }
    },
    {
      "name": "With Docker",
      "parameters": {
        "with_docker": "true"
      },
      "envs": {
        "DOCKER_NETWORK": "default"
      }
    },
    {
      "name": "With Aiogram utils",
      "parameters": {
        "with_aiogram_utils": "true"
      }
    },
    {
      "name": "With Aiohttp utils",
      "parameters": {
        "with_aiohttp_utils": "true",
        "with_json_utils": "true"
      }
    },
    {
      "name": "With json utils",
      "parameters": {
        "with_json_utils": "true"
      }
    },
    {
      "name": "All",
      "parameters": {
        "with_trivy": "true",
        "with_ngrok": "true",
        "with_docker": "true",
        "with_aiogram_utils": "true",
        "with_aiohttp_utils": "true",
        "with_json_utils": "true"
      },
      "envs": {
        "DOCKER_NETWORK": "default"
      }
    }
  ]
}
