#!/usr/bin/env bash
#MISE description="Run image in container"
#USAGE arg "<target>"
#USAGE flag "--hostname <hostname>"
#USAGE flag "--exposed-port <port>"
set -euo pipefail

args=()
if [ -n "${usage_hostname:-}" ]; then
  args+=(--hostname "${usage_hostname}")
fi
if [ -n "${usage_exposed_port:-}" ]; then
  args+=(--publish "${usage_exposed_port}:${usage_exposed_port}")
fi

echo "Running image ${usage_target} target..."
# bash 3.2 treats an empty array as unbound under set -u
docker run \
{%- if cookiecutter.with_docker == 'true' %}
  --network "${DOCKER_NETWORK}" \
{%- endif %}
  ${args[@]+"${args[@]}"} \
  --env-file <(env | cut -f1 -d=) \
  --volume "${MISE_CONFIG_ROOT}/.settings:/settings" \
{%- if cookiecutter.with_docker == 'true' %}
  --env SETTINGS_PATH="/settings/dev_docker.yaml:/settings/dev.yaml" \
  --env SETTINGS_TEST_PATH="/settings/test_docker.yaml:/settings/test.yaml" \
{%- else %}
  --env SETTINGS_PATH="/settings/dev.yaml" \
  --env SETTINGS_TEST_PATH="/settings/test.yaml" \
{%- endif %}
  "{{cookiecutter.service_slug}}:${usage_target}"
